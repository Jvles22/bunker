<?xml version="1.0"?>
<sdf version="1.6">
  <world name="forest_world">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- PINS -->
    <include><uri>model://Pine Tree</uri><name>pine_1</name><pose>3 2 0 0 0 0</pose></include>
    <include><uri>model://Pine Tree</uri><name>pine_2</name><pose>-3 4 0 0 0 1.2</pose></include>
    <include><uri>model://Pine Tree</uri><name>pine_3</name><pose>5 -3 0 0 0 0.5</pose></include>
    <include><uri>model://Pine Tree</uri><name>pine_4</name><pose>-5 -2 0 0 0 2.1</pose></include>
    <include><uri>model://Pine Tree</uri><name>pine_5</name><pose>7 1 0 0 0 0.8</pose></include>

    <!-- CHENES -->
    <include><uri>model://Oak tree</uri><name>oak_1</name><pose>2 -5 0 0 0 0</pose></include>
    <include><uri>model://Oak tree</uri><name>oak_2</name><pose>-4 -4 0 0 0 1.5</pose></include>
    <include><uri>model://Oak tree</uri><name>oak_3</name><pose>6 5 0 0 0 0.3</pose></include>
    <include><uri>model://Oak tree</uri><name>oak_4</name><pose>-6 3 0 0 0 2.5</pose></include>

    <!-- ROCHERS -->
    <include><uri>model://Falling Rock 2</uri><name>rock_1</name><pose>1 3 0 0 0 0</pose></include>
    <include><uri>model://Falling Rock 2</uri><name>rock_2</name><pose>-2 -3 0 0 0 1.0</pose></include>
    <include><uri>model://Medium Rock Fall</uri><name>rock_3</name><pose>4 -1 0 0 0 0.7</pose></include>
    <include><uri>model://Medium Rock Fall</uri><name>rock_4</name><pose>-1 5 0 0 0 2.0</pose></include>
    <include><uri>model://Medium Rock Fall</uri><name>rock_5</name><pose>-4 1 0 0 0 1.3</pose></include>

  </world>
</sdf>
