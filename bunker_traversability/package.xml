<?xml version="1.0"?>
<package format="2">
  <name>bunker_traversability</name>
  <version>1.0.0</version>
  <description>
    Traversability-based costmap layer and elevation map for slope-aware navigation.
    Provides a CostmapLayer plugin that encodes terrain slope as variable cost,
    allowing move_base to distinguish traversable ramps from impassable obstacles.
  </description>
  <maintainer email="jules@example.com">jules</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>grid_map_core</depend>
  <depend>grid_map_ros</depend>
  <depend>grid_map_msgs</depend>

  <export>
    <!-- Expose the costmap_2d plugin to the pluginlib system -->
    <costmap_2d plugin="${prefix}/plugins.xml"/>
  </export>
</package>
