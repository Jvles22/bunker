<launch>
  <!-- ================================================================== -->
  <!--  bunker_traversability — Nœud de carte d'élévation                 -->
  <!--  À lancer après Gazebo + LIO-SAM (TF map→base_footprint requis)    -->
  <!-- ================================================================== -->

  <!-- Filtre adaptatif de hauteur LiDAR (C++) -->
  <!-- Publie /velodyne_points_filtered dans le repère map             -->
  <!-- Remplace adaptive_obstacle_filter_node.py (gardé pour référence) -->
  <node pkg="bunker_traversability"
        type="adaptive_obstacle_filter_node"
        name="adaptive_obstacle_filter"
        output="screen"/>

  <!-- Carte d'élévation (consomme /velodyne_points directement) -->
  <node pkg="bunker_traversability"
        type="bunker_elevation_map_node"
        name="bunker_elevation_map"
        output="screen">
    <rosparam file="$(find bunker_traversability)/config/elevation_map.yaml"
              command="load"/>
  </node>
</launch>
