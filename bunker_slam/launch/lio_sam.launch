<launch>
  <!-- Paramètres LIO-SAM adaptés au Bunker -->
  <rosparam file="$(find bunker_slam)/config/lio_sam_params.yaml" command="load"/>

  <!-- imageProjection : segmentation du nuage de points -->
  <node pkg="lio_sam" type="lio_sam_imageProjection"
        name="lio_sam_imageProjection" output="screen"/>

  <!-- imuPreintegration : fusion IMU -->
  <node pkg="lio_sam" type="lio_sam_imuPreintegration"
        name="lio_sam_imuPreintegration" output="screen"/>

  <!-- featureExtraction : extraction de features LOAM -->
  <node pkg="lio_sam" type="lio_sam_featureExtraction"
        name="lio_sam_featureExtraction" output="screen"/>

  <!-- mapOptimization : construction de la carte + loop closure -->
  <node pkg="lio_sam" type="lio_sam_mapOptmization"
        name="lio_sam_mapOptmization" output="screen"/>
</launch>
