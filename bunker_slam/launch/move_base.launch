<launch>
  <!-- ======= ARGUMENT: choisir le planner ======= -->
  <arg name="planner" default="teb" doc="Local planner: dwa, teb, eband"/>

  <!-- Nœud de carte d'élévation (requis par traversability_layer) -->
  <include file="$(find bunker_traversability)/launch/traversability.launch"/>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <!-- Costmaps -->
    <rosparam file="$(find bunker_slam)/config/move_base/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find bunker_slam)/config/move_base/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find bunker_slam)/config/move_base/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find bunker_slam)/config/move_base/local_costmap_params.yaml"
              command="load"/>

    <!-- Paramètres généraux move_base -->
    <rosparam file="$(find bunker_slam)/config/move_base/move_base_params.yaml"
              command="load"/>

    <!-- Config du planner sélectionné -->
    <rosparam file="$(find bunker_slam)/config/move_base/$(arg planner)_params.yaml"
              command="load"/>

    <!-- Global planner -->
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>

    <!-- Local planner: switch automatique selon l'argument -->
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"
           if="$(eval arg('planner') == 'dwa')"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"
           if="$(eval arg('planner') == 'teb')"/>
    <param name="base_local_planner" value="eband_local_planner/EBandPlannerROS"
           if="$(eval arg('planner') == 'eband')"/>

    <!-- Params spécifiques WSL2 -->
    <param name="controller_frequency" value="2.0"/>
    <param name="planner_frequency" value="0.5"/>
    <param name="transform_tolerance" value="1.0"/>
  </node>
</launch>
