<launch>
  <arg name="model" default="$(find bunker_description)/urdf/bunker.urdf.xacro"/>
  <arg name="world" default="$(find bunker_gazebo)/worlds/slopes_simple5.world"/>
  <arg name="x" default="-10"/>
  <arg name="y" default="-12"/>
  <arg name="z" default="0.5"/>

  <!-- TF de secours odom→base_footprint avant démarrage LIO-SAM -->
  <!-- Désactivé en mode debug (slam:=false) où l'EKF prend ce rôle -->
  <arg name="slam" default="true"/>
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="odom_to_base_footprint_init"
        args="0 0 0 0 0 0 odom base_footprint"
        if="$(arg slam)"/>

  <!-- Charger le robot -->
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>

  <!-- Fix permanent GAZEBO_MODEL_PATH -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find bunker_gazebo)/gazebo_models:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- Gazebo — slopes_simple -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused"        value="false"/>
    <arg name="use_sim_time"  value="true"/>
    <arg name="gui"           value="false"/>
  </include>

  <!-- Spawn robot au point de départ (0, 0) -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -model bunker -param robot_description
              -x $(arg x) -y $(arg y) -z $(arg z) -Y 0"/>

  <!-- State publishers -->
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher"/>
  <node name="joint_state_publisher" pkg="joint_state_publisher"
        type="joint_state_publisher"/>
</launch>
